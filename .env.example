# ─────────────────────────────────────────────────────────────
# 환경변수 예시 파일.
# 사용법: 이 파일을 복사해 '.env' 로 만들고 값을 채우세요.
#   cp .env.example .env
# 주의: 실제 .env 파일은 절대 git에 커밋하지 마세요. (.gitignore에 이미 제외됨)
# ─────────────────────────────────────────────────────────────

# [공통]
# SECRET_KEY: 반드시 새로 생성한 무작위 값으로 교체하세요.
#   생성 예:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=여기에-무작위-비밀키를-넣으세요

# 디버그 모드. 배포에서는 반드시 False.
DJANGO_DEBUG=False

# 접속을 허용할 도메인/호스트 (쉼표로 구분)
DJANGO_ALLOWED_HOSTS=report.school.example.com

# 관리자 2단계 인증(OTP) 강제 여부. 배포에서는 True 권장.
ADMIN_REQUIRE_OTP=True

# [배포(production)에서만 필요 — PostgreSQL(RDS)]
DB_NAME=reportdb
DB_USER=reportuser
DB_PASSWORD=여기에-DB-비밀번호
DB_HOST=your-rds-endpoint.xxxxxx.ap-northeast-2.rds.amazonaws.com
DB_PORT=5432
# RDS 연결 TLS 강제 (require 권장)
DB_SSLMODE=require

# CSRF 신뢰 출처 (https 스킴 포함, 쉼표 구분)
CSRF_TRUSTED_ORIGINS=https://report.school.example.com
